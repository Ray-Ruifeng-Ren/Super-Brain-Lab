# 复制到服务器 /srv/zhuxiang/secrets.env,填好后 chmod 600。这个文件只放服务器上,不要提交、不要发给别人。
# 国内服务的访问地址(备案好的新域名),不带结尾的 /
PUBLIC_URL=https://example.cn
# 以下三项在 Supabase 控制台 → Project Settings → API(Legacy API keys / JWT secret)里复制。
# 沿用这三项:网页和 App 里的 anon key 不用换,搬过去的老用户登录状态继续有效。
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# 可选:Docker 镜像加速(空格分隔,火山引擎官方地址放第一个)
# DOCKER_MIRRORS="https://docker.m.daocloud.io https://docker.1ms.run"
